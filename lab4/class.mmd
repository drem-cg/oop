classDiagram
    class CPoint {
        +double x
        +double y
    }

    class IShape {
        <<interface>>
        +virtual double GetArea() const = 0
        +virtual double GetPerimeter() const = 0
        +virtual uint32_t GetOutlineColor() const = 0
        +virtual std:: string ToString() const = 0
        +virtual~ IShape() = default
    }

    class ISolidShape {
        <<interface>>
        +virtual uint32_t GetFillColor() const = 0
        +virtual~ ISolidShape() = default
    }

    class CLineSegment {
        +CLineSegment(CPoint start, CPoint end, uint32_t outlineColor)
        +double GetArea() const override
        +double GetPerimeter() const override
        +std:: string ToString() const override
        +uint32_t GetOutlineColor() const override
        +CPoint GetStartPoint() const
        +CPoint GetEndPoint() const
        -CPoint m_start
        -CPoint m_end
        -uint32_t m_outlineColor
    }

    class CTriangle {
        +CTriangle(CPoint v1, CPoint v2, CPoint v3, uint32_t outline, uint32_t fill)
        +double GetArea() const override
        +double GetPerimeter() const override
        +std:: string ToString() const override
        +uint32_t GetOutlineColor() const override
        +uint32_t GetFillColor() const override
        +CPoint GetVertex1() const
        +CPoint GetVertex2() const
        +CPoint GetVertex3() const
        -CPoint m_v1, m_v2, m_v3
        -uint32_t m_outlineColor
        -uint32_t m_fillColor
    }

    class CRectangle {
        +CRectangle(CPoint leftTop, CPoint rightBottom, uint32_t outline, uint32_t fill)
        +double GetArea() const override
        +double GetPerimeter() const override
        +std:: string ToString() const override
        +uint32_t GetOutlineColor() const override
        +uint32_t GetFillColor() const override
        +CPoint GetLeftTop() const
        +CPoint GetRightBottom() const
        +double GetWidth() const
        +double GetHeight() const
        -CPoint m_leftTop
        -CPoint m_rightBottom
        -uint32_t m_outlineColor
        -uint32_t m_fillColor
    }

    class CCircle {
        +CCircle(CPoint center, double radius, uint32_t outline, uint32_t fill)
        +double GetArea() const override
        +double GetPerimeter() const override
        +std:: string ToString() const override
        +uint32_t GetOutlineColor() const override
        +uint32_t GetFillColor() const override
        +CPoint GetCenter() const
        +double GetRadius() const
        -CPoint m_center
        -double m_radius
        -uint32_t m_outlineColor
        -uint32_t m_fillColor
    }

    IShape <|.. CLineSegment
    ISolidShape <|.. CTriangle
    ISolidShape <|.. CRectangle
    ISolidShape <|.. CCircle
    IShape <|-- ISolidShape